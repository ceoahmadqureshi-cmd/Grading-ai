# =============================================================
# Copy this file to .env.local and fill in your OWN values.
# NEVER commit .env.local or paste real keys into chat / git.
# If a key was ever pasted publicly, revoke and regenerate it.
# =============================================================

# --- Supabase --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# --- AI provider swap -------------------------------------------
# "google" or "openai" -- swap the whole grading engine with one line
AI_PROVIDER=google

# Get a free key at https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-key
GOOGLE_MODEL=gemini-2.5-flash   # or gemini-2.5-pro for higher accuracy

# Only needed if AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-key
OPENAI_MODEL=gpt-4o

# --- Hardcoded demo logins (see supabase/schema.sql) -------------
# centre_a@demo.tutoros.hk / centre_b@demo.tutoros.hk
# Passwords are set when you run the seed script — see README.md
